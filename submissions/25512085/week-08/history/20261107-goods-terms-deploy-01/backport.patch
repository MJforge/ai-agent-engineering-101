+    def test_invalid_or_conflicting_conditions_never_sign(self):
+        for text in ('grade=D', 'warranty_hours=-1', 'warranty_hours=nan',
+                     'warranty_hours=73', 'grade=C warranty 6h', 'grade=A grade=C',
